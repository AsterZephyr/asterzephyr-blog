---
import BaseHead from '../components/BaseHead.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : SITE.title;
const pageDescription = description || SITE.description;
---
<!doctype html>
<html lang="en" data-language="zh">
  <head>
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('asterzephyr-language'); } catch {}
        const requested = new URLSearchParams(location.search).get('lang');
        const language = requested === 'zh' || requested === 'en' ? requested : saved === 'zh' || saved === 'en' ? saved :
          ((navigator.languages?.[0] || navigator.language || 'en').toLowerCase().startsWith('zh') ? 'zh' : 'en');
        document.documentElement.dataset.language = language;
      })();
    </script>
    <BaseHead title={pageTitle} description={pageDescription} image={image} />
  </head>
  <body class="min-h-screen bg-[var(--color-surface)]">
    <slot />
    <SearchDialog />
  </body>
</html>
<script>
  import '../scripts/language';
</script>

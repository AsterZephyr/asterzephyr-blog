---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Prose from '../components/Prose.astro';
import TOC from '../components/TOC.astro';
import TagList from '../components/TagList.astro';
import PrevNext from '../components/PrevNext.astro';
import type { CollectionEntry } from 'astro:content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'posts'>;
  headings: Heading[];
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
}

const { post, headings, prev, next } = Astro.props;
const { title, date, updated, tags, cover, summary } = post.data;
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const formattedUpdated = updated?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout title={title} description={summary || title} image={cover}>
  <Header />
  <article class="pt-28 pb-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="max-w-3xl mx-auto">
        <header class="mb-12">
          <time class="text-sm uppercase tracking-wider text-[var(--color-muted)]">{formattedDate}</time>
          {formattedUpdated && (
            <span class="text-sm text-[var(--color-muted)] ml-3">
              (Updated: {formattedUpdated})
            </span>
          )}
          <h1 class="font-heading text-3xl md:text-4xl font-bold mt-3 mb-4">{title}</h1>
          {summary && <p class="text-lg text-[var(--color-muted)]">{summary}</p>}
          {tags.length > 0 && (
            <div class="mt-4">
              <TagList tags={tags} />
            </div>
          )}
        </header>
      </div>

      <div class="max-w-3xl mx-auto">
        {cover && (
            <img src={cover} alt={title} class="w-full mb-10 rounded-sm" />
          )}
          <Prose>
            <slot />
          </Prose>
          <PrevNext prev={prev} next={next} />
        </div>
      </div>
  </article>
  <Footer />
</BaseLayout>

<script>
async function renderMermaidDiagrams() {
  const preBlocks = document.querySelectorAll('pre[data-language="mermaid"]');
  if (preBlocks.length === 0) return;

  const { default: mermaid } = await import(
    'https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.esm.min.mjs'
  );

  mermaid.initialize({
    startOnLoad: false,
    theme: 'base',
    themeVariables: {
      darkMode: false,
      background: '#ffffff',
      fontSize: '16px',
      fontFamily: 'Open Sans, sans-serif',
      primaryColor: '#fef3c7',
      primaryTextColor: '#1a1a1a',
      primaryBorderColor: '#b45309',
      secondaryColor: '#f5f5f4',
      tertiaryColor: '#fffbeb',
      lineColor: '#78716c',
      textColor: '#3d3d3d',
      mainBkg: '#fef3c7',
      nodeBorder: '#b45309',
      clusterBkg: '#faf8f5',
      clusterBorder: '#d6d3d1',
      titleColor: '#b45309',
      edgeLabelBackground: '#ffffff',
      nodeTextColor: '#1a1a1a',
      actorTextColor: '#1a1a1a',
      actorBkg: '#fffbeb',
      actorBorder: '#b45309',
      actorLineColor: '#78716c',
      signalColor: '#78716c',
      signalTextColor: '#1a1a1a',
      labelBoxBkgColor: '#fffbeb',
      labelBoxBorderColor: '#d6d3d1',
      labelTextColor: '#3d3d3d',
      loopTextColor: '#3d3d3d',
      noteBkgColor: '#fef3c7',
      noteBorderColor: '#d97706',
      noteTextColor: '#1a1a1a',
      sectionBkgColor: '#fffbeb',
      sectionBkgColor2: '#fef3c7',
      taskBkgColor: '#fbbf24',
      taskTextColor: '#1a1a1a',
      taskBorderColor: '#b45309',
      activeTaskBkgColor: '#d97706',
      activeTaskBorderColor: '#b45309',
    },
  });

  for (const pre of preBlocks) {
    const graphDefinition = pre.textContent || '';
    const id = `mermaid-${crypto.randomUUID()}`;

    try {
      const { svg } = await mermaid.render(id, graphDefinition);
      const container = document.createElement('div');
      container.classList.add('mermaid-diagram');
      container.innerHTML = svg;
      pre.replaceWith(container);
    } catch (error) {
      console.error('Mermaid rendering failed:', error);
    }
  }
}

renderMermaidDiagrams();
document.addEventListener('astro:after-swap', renderMermaidDiagrams);
</script>

<style is:global>
  .mermaid-diagram {
    display: flex;
    justify-content: center;
    margin: 1.5rem 0;
    padding: 1.5rem 1rem;
    overflow-x: auto;
    background: #faf8f5;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
  }
  .mermaid-diagram svg {
    max-width: 100%;
    height: auto;
    font-size: 16px;
  }
</style>

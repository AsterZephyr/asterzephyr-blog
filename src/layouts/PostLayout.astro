---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Prose from '../components/Prose.astro';
import TOC from '../components/TOC.astro';
import ReaderTools from '../components/ReaderTools.astro';
import '../styles/reader.css';
import TagList from '../components/TagList.astro';
import PrevNext from '../components/PrevNext.astro';
import PostDiscovery from '../components/PostDiscovery.astro';
import SharePost from '../components/SharePost.astro';
import { socialImagePath } from '../lib/social-card.mjs';
import { TAG_LABELS } from '../data/blog-tags';
import LocalizedText from '../components/LocalizedText.astro';
import type { CollectionEntry } from 'astro:content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<'posts'>;
  translation?: CollectionEntry<'translations'>;
  headings: Heading[];
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
}

const { post, translation, headings, prev, next } = Astro.props;
const { title, date, updated, tags, cover, summary } = post.data;
const hasFigures = Boolean(cover) || /<(Figure|TechGraph|img)\b|!\[/.test(post.body || '');
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const formattedUpdated = updated?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout title={title} description={summary || title} image={socialImagePath(post.id)}>
  <Header />
  <article data-post-id={post.id} data-post-date={date.toISOString().slice(0, 10)} data-post-topics={tags.map((t) => TAG_LABELS[t] || t).join(' · ')} class="pt-32 md:pt-40 pb-16" data-has-translation={translation ? '' : undefined}
    data-post-title-zh={title} data-post-title-en={translation?.data.title}
    data-post-summary-zh={summary || title} data-post-summary-en={translation?.data.summary || translation?.data.title}>
    <div class="mx-auto max-w-6xl px-6">
      <div class="max-w-3xl mx-auto">
        <header class="mb-12 pb-10 border-b border-[var(--color-border)]">
          <time datetime={date.toISOString()} class="text-sm uppercase tracking-wider text-[var(--color-muted)]">{formattedDate}</time>
          {formattedUpdated && (
            <span class="text-sm text-[var(--color-muted)] ml-3">
              (<LocalizedText zh="更新于" en="Updated" />: <time datetime={updated?.toISOString()}>{formattedUpdated}</time>)
            </span>
          )}
          <h1 class="reading-title mt-4 mb-4">{translation ? <LocalizedText content zh={title} en={translation.data.title} /> : <span lang="zh-CN">{title}</span>}</h1>
          {summary && <p class="reading-summary">{translation?.data.summary ? <LocalizedText content zh={summary} en={translation.data.summary} /> : <span lang="zh-CN">{summary}</span>}</p>}
          {tags.length > 0 && (
            <div class="mt-4">
              <TagList tags={tags} />
            </div>
          )}
          <SharePost image={socialImagePath(post.id)} title={title} hasTranslation={Boolean(translation)} />
        </header>
      </div>

      <div class="reader-layout">
        <TOC headings={headings} />
        <div class="reader-body">
          <div class="reader-resume" hidden>
            <button type="button" data-resume-reading></button>
            <button type="button" data-dismiss-resume aria-label="Dismiss saved position">×</button>
          </div>
        {cover && (
            <img src={cover} alt={title} data-alt-zh={title} data-alt-en={translation?.data.title || title} class="w-full mb-10 rounded-sm" />
          )}
          {translation ? (
            <p class="translation-credit" data-lang="en" lang="en">English edition.{hasFigures && ' Figures retain their original language.'}</p>
          ) : (
            <aside class="translation-notice" data-lang="en" lang="en">This article is currently available in Chinese only. You can still browse the rest of the site in English.</aside>
          )}
          <div data-article-content data-content-language="zh" lang="zh-CN">
            <Prose><slot /></Prose>
          </div>
          {translation && <template data-english-content><Prose><slot name="english" /></Prose></template>}
          <PostDiscovery post={post} />
          <PrevNext prev={prev} next={next} />
        </div>
      </div>
      </div>
  </article>
  <ReaderTools />
  <Footer />
</BaseLayout>

<script>
async function renderMermaidDiagrams() {
  const preBlocks = document.querySelectorAll('pre[data-language="mermaid"]:not([data-rendering])');
  if (preBlocks.length === 0) return;
  preBlocks.forEach((pre) => pre.setAttribute('data-rendering', 'true'));

  try {
  const { default: mermaid } = await import(
    'https://cdn.jsdelivr.net/npm/mermaid@11.14.0/dist/mermaid.esm.min.mjs'
  );

  mermaid.initialize({
    startOnLoad: false,
    theme: 'base',
    themeVariables: {
      darkMode: false,
      background: '#ffffff',
      fontSize: '16px',
      fontFamily: 'Open Sans, sans-serif',
      primaryColor: '#fef3c7',
      primaryTextColor: '#1a1a1a',
      primaryBorderColor: '#b45309',
      secondaryColor: '#f5f5f4',
      tertiaryColor: '#fffbeb',
      lineColor: '#78716c',
      textColor: '#3d3d3d',
      mainBkg: '#fef3c7',
      nodeBorder: '#b45309',
      clusterBkg: '#faf8f5',
      clusterBorder: '#d6d3d1',
      titleColor: '#b45309',
      edgeLabelBackground: '#ffffff',
      nodeTextColor: '#1a1a1a',
      actorTextColor: '#1a1a1a',
      actorBkg: '#fffbeb',
      actorBorder: '#b45309',
      actorLineColor: '#78716c',
      signalColor: '#78716c',
      signalTextColor: '#1a1a1a',
      labelBoxBkgColor: '#fffbeb',
      labelBoxBorderColor: '#d6d3d1',
      labelTextColor: '#3d3d3d',
      loopTextColor: '#3d3d3d',
      noteBkgColor: '#fef3c7',
      noteBorderColor: '#d97706',
      noteTextColor: '#1a1a1a',
      sectionBkgColor: '#fffbeb',
      sectionBkgColor2: '#fef3c7',
      taskBkgColor: '#fbbf24',
      taskTextColor: '#1a1a1a',
      taskBorderColor: '#b45309',
      activeTaskBkgColor: '#d97706',
      activeTaskBorderColor: '#b45309',
    },
  });

  for (const pre of preBlocks) {
    if (!pre.isConnected) { pre.removeAttribute('data-rendering'); continue; }
    const graphDefinition = pre.textContent || '';
    const id = `mermaid-${crypto.randomUUID()}`;

    try {
      const { svg } = await mermaid.render(id, graphDefinition);
      const container = document.createElement('div');
      container.classList.add('mermaid-diagram');
      container.innerHTML = svg;
      pre.replaceWith(container);
    } catch (error) {
      pre.removeAttribute('data-rendering');
      console.error('Mermaid rendering failed:', error);
    }
  }
  } catch (error) {
    preBlocks.forEach((pre) => pre.removeAttribute('data-rendering'));
    console.error('Mermaid could not be loaded:', error);
  }
}

renderMermaidDiagrams();
document.addEventListener('astro:after-swap', renderMermaidDiagrams);
document.addEventListener('languagechange', renderMermaidDiagrams);
</script>

<style is:global>
  .mermaid-diagram {
    display: flex;
    justify-content: center;
    margin: 1.5rem 0;
    padding: 1.5rem 1rem;
    overflow-x: auto;
    background: #faf8f5;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
  }
  .mermaid-diagram svg {
    max-width: 100%;
    height: auto;
    font-size: 16px;
  }
</style>

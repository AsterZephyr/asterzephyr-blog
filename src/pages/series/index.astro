---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { SERIES } from '../../data/series';
import { resolveSeries } from '../../lib/discovery.mjs';
const series = resolveSeries(SERIES, await getCollection('posts'));
---
<PageLayout title="Reading series" description="Curated paths through recommendation systems, agents, and their foundations.">
  <div class="mx-auto max-w-6xl px-6 pt-32 md:pt-40 pb-20">
    <p class="eyebrow mb-4">Follow a thread</p><h1 class="display-heading">Reading series</h1>
    <p class="mt-5 mb-12 text-[var(--color-muted)]">A few paths through the archive, arranged in the order I would read them.</p>
    {series.map((s) => <a class="series-row" href={`/series/${s.id}/`}><div><h2>{s.title}</h2><p>{s.description}</p></div><span>{s.posts.length} articles ↗</span></a>)}
    <a href="/blog/" class="text-link mt-10">All writing</a>
  </div>
</PageLayout>
<style>
  .series-row { display: flex; justify-content: space-between; gap: 24px; padding-block: 30px; border-top: 1px solid var(--color-border); }
  h2 { font: 400 clamp(24px, 3vw, 34px)/1.3 var(--font-heading); }
  p { margin-top: 12px; color: var(--color-muted); max-width: 680px; font-size: 14px; line-height: 1.8; }
  .series-row > span { flex-shrink: 0; font-size: 12px; color: var(--color-accent); padding-top: 10px; }
  .series-row:hover h2 { color: var(--color-accent); }
  @media(max-width: 600px) { .series-row { flex-direction: column; gap: 6px; } }
</style>

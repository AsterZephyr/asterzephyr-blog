<dialog id="site-search" aria-labelledby="search-heading">
  <div class="search-top"><h2 id="search-heading">Search the journal</h2><button type="button" data-search-close aria-label="Close search">Close ×</button></div>
  <form role="search"><label class="sr-only" for="fulltext-query">Search article text</label><input id="fulltext-query" type="search" placeholder="Ideas, questions, or a phrase…" maxlength="200" autocomplete="off" autofocus />
    <label class="search-language">Language <select name="language" aria-label="Search language"><option value="all">Both languages</option><option value="en">English</option><option value="zh">Chinese</option></select></label>
  </form>
  <p data-search-status role="status">Search full articles in English and Chinese.</p>
  <ol data-search-results></ol>
  <button type="button" data-search-more hidden>Show more results</button>
  <p class="search-help"><span>⌘ / Ctrl K to search · Esc to close</span><a href="/blog/">Browse all writing ↗</a></p>
</dialog>
<script>
  import '../scripts/search';
</script>
<style is:global>
  #site-search { width: min(760px, calc(100vw - 32px)); max-height: min(780px, calc(100dvh - 48px)); margin: 24px auto auto; border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-body); padding: 28px; border-radius: 4px; box-shadow: 0 24px 100px #26272233; overflow-y: auto; }
  #site-search::backdrop { background: #26272266; }
  .search-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .search-top h2 { font: 400 28px/1.3 var(--font-heading); color: var(--color-heading); }
  .search-top button { font-size: 12px; min-height: 44px; }
  #site-search form { margin-top: 22px; }
  #fulltext-query { width: 100%; min-height: 52px; background: transparent; font-size: 18px; border: 0; border-bottom: 1px solid var(--color-accent); border-radius: 0; padding: 10px 0; }
  .search-language { display: flex; gap: 12px; align-items: center; margin-top: 18px; font-size: 12px; }
  .search-language select { background: var(--color-surface); border: 1px solid var(--color-border); padding: 6px 24px 6px 10px; color: var(--color-heading); }
  [data-search-status] { margin: 20px 0 8px; color: var(--color-muted); font-size: 12px; }
  [data-search-results] { list-style: none; padding: 0; }
  .search-result { padding: 20px 0; border-bottom: 1px solid var(--color-border); }
  .search-result h3 { font: 400 21px/1.45 var(--font-heading); color: var(--color-heading); margin: 7px 0 10px; }
  .search-result a:hover { color: var(--color-accent); text-decoration: underline; text-underline-offset: 4px; }
  .search-result p { font-size: 13px; line-height: 1.8; overflow-wrap: anywhere; }
  .search-result small { font-size: 10px; letter-spacing: .08em; color: var(--color-muted); }
  .search-result mark { background: #e9dbbc; color: var(--color-heading); }
  .search-section { display: block; font-size: 12px; line-height: 1.6; margin-top: 10px; }
  [data-search-more] { padding: 14px 0; color: var(--color-accent); font-size: 13px; }
  .search-help { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-top: 24px; font-size: 11px; color: var(--color-muted); }
  @media(max-width: 600px) { #site-search { padding: 20px; margin-top: 16px; max-height: calc(100dvh - 32px); } .search-top h2 { font-size: 24px; } }
</style>

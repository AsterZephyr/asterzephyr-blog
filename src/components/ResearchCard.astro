---
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'research'>;
}

const { item } = Astro.props;
const { title, authors, venue, cover, paper, project: projectUrl } = item.data;
---
<div class="flex flex-col md:flex-row gap-6 bg-white border border-[var(--color-border)] p-6 hover:border-[var(--color-accent-glow)]/50 hover:shadow-md transition-all duration-300 relative overflow-hidden group">
  <div class="absolute top-0 left-0 w-1 h-full bg-[var(--color-accent-light)] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
  {cover && (
    <div class="md:w-48 flex-shrink-0">
      <img src={cover} alt={title} class="w-full h-32 md:h-full object-cover" loading="lazy" />
    </div>
  )}
  <div class="flex-1">
    <h3 class="font-heading text-lg font-semibold mb-2 group-hover:text-[var(--color-accent)] transition-colors">{title}</h3>
    <p class="text-sm text-[var(--color-muted)] mb-1">{authors}</p>
    <p class="text-sm font-medium text-[var(--color-body)] mb-4">{venue}</p>
    <div class="flex flex-wrap gap-3">
      {paper && (
        <a href={paper} target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-wider text-[var(--color-accent)] hover:text-[var(--color-accent-light)] hover:underline transition-colors">
          Paper
        </a>
      )}
      {projectUrl && (
        <a href={projectUrl} target="_blank" rel="noopener noreferrer" class="text-xs uppercase tracking-wider text-[var(--color-accent)] hover:text-[var(--color-accent-light)] hover:underline transition-colors">
          Project
        </a>
      )}
    </div>
  </div>
</div>

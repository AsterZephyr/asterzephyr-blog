---
import { SITE } from '../data/site';
interface Props { transparent?: boolean; }
const { transparent = false } = Astro.props;
const currentPath = Astro.url.pathname;
---
<nav id="navbar" class:list={['site-nav', { 'nav-transparent': transparent }]} data-transparent={transparent} aria-label="Primary navigation">
  <div class="nav-inner">
    <a href="/" class="nav-brand">{SITE.name}<span aria-hidden="true">.</span></a>
    <ul class="hidden md:flex items-center gap-8">
      {SITE.nav.map((item) => (
        <li><a href={item.href} class="nav-link" aria-current={currentPath.startsWith(item.href) && !item.href.includes('#') ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
    <details id="nav-mobile" class="mobile-menu md:hidden">
      <summary aria-label="Toggle navigation"><span class="menu-label">Menu</span><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-width="1.5" d="M4 8h16M4 16h16" /></svg></summary>
      <ul>
        {SITE.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </details>
  </div>
</nav>
<style>
  .site-nav { position: fixed; inset: 0 0 auto; z-index: 50; background: var(--color-surface); color: var(--color-heading); border-bottom: 1px solid var(--color-border); transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease; }
  .nav-transparent { background: transparent; color: #f7f0e3; border-color: transparent; }
  .nav-transparent.nav-scrolled { background: var(--color-surface); color: var(--color-heading); border-color: var(--color-border); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; max-width: 1152px; height: 80px; padding-inline: 24px; margin-inline: auto; }
  .nav-brand { font-family: var(--font-heading); font-size: 25px; letter-spacing: -.045em; }
  .nav-brand span { margin-left: 2px; }
  .nav-link { position: relative; display: inline-block; padding-block: 12px; font-size: 12px; letter-spacing: .04em; }
  .nav-link::after { position: absolute; content: ''; left: 0; right: 0; bottom: 6px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 180ms ease; }
  .nav-link[aria-current='page']::after, .nav-link:focus-visible::after { transform: scaleX(1); }
  .mobile-menu summary { display: flex; align-items: center; gap: 10px; min-height: 44px; cursor: pointer; list-style: none; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .menu-label { font-size: 11px; }
  .mobile-menu ul { position: absolute; top: 100%; left: 0; right: 0; padding: 12px 24px 20px; background: var(--color-surface); color: var(--color-heading); border-bottom: 1px solid var(--color-border); }
  .mobile-menu li a { display: block; padding-block: 14px; font-size: 14px; }
  @media (hover: hover) { .nav-link:hover::after { transform: scaleX(1); } }
  @media (max-width: 767px) { .nav-inner { height: 64px; } .nav-brand { font-size: 23px; } }
</style>
<script>
  const navbar = document.getElementById('navbar');
  const mobile = document.querySelector<HTMLDetailsElement>('#nav-mobile');
  if (navbar?.dataset.transparent === 'true') {
    const update = () => navbar.classList.toggle('nav-scrolled', window.scrollY > 80);
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
  mobile?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { mobile.open = false; }));
  mobile?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') { mobile.open = false; mobile.querySelector('summary')?.focus(); }
  });
</script>

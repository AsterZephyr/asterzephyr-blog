---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const allProjects = await getCollection('projects');
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 6);

const projects = featured.length > 0 ? featured : allProjects.slice(0, 6);
---
{projects.length > 0 && (
  <section id="projects-home" class="section-wrap border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="section-heading">
        <div><p class="eyebrow mb-3">From ideas to working systems</p><h2 class="section-title">Selected projects</h2></div>
        <a href="/projects" class="text-link">All projects</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
)}

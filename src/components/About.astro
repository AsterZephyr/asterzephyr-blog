---
import { SITE } from '../data/site';
import LocalizedText from './LocalizedText.astro';

---
<section id="about" class="section-wrap viewport-section">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-12 lg:gap-20 items-start">
      <div class="md:col-span-2">
        <div class="relative md:pr-8">
          <img
            src="/images/avatar.jpg?v=0c403407bff7"
            alt={`Photo of ${SITE.name}`}
            class="w-full max-w-sm aspect-[4/5] object-cover"
            width="480" height="600"
            loading="lazy"
          />
        </div>
      </div>
      <div class="md:col-span-3">
        <h2 class="section-title mb-8">
          <LocalizedText zh="关于我" en="About me" />
        </h2>
        <p class="eyebrow mb-6"><LocalizedText zh="工程、算法、产品、运营与商务" en="Engineering, algorithms, product, operations & business" /></p>
        <p class="text-base leading-[1.9] mb-4"><LocalizedText en={SITE.bio} zh="我是何星泽，目前在蓝色光标从事软件工程工作。我参与广告系统建设，工作涵盖后端基础设施、模型服务、实验与业务分析。我喜欢沿着一个问题走到底：理解人们的需求，与团队一起构建解决方案，再看它进入真实世界后究竟带来了什么改变。" /></p>
        <p class="text-base leading-[1.9] mb-4"><LocalizedText en={SITE.bioExtended} zh="最近，我的许多工作都在探索 AI 如何帮助人们研究、构建和决策。我开发面向工程与运营的 Agent 工具和可复用工作流，通过技术指南和开源项目分享经验。我的兴趣包括推荐系统、AI 基础设施，以及让工具真正有用的产品决策。" /></p>
        <p class="text-base leading-[1.9] mb-8 text-[var(--color-muted)]"><LocalizedText en={SITE.bioSide} zh="除了工程笔记，这里也记录我对经济学、哲学、学习与生活的思考。我关心激励如何影响行为，人们如何在信息不完整时决策，以及微小的努力如何随时间积累。写作帮助我把这些问题与自己的工作和生活连接起来。" /></p>
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="/resume"
            target="_blank" rel="noopener noreferrer"
            class="text-link"
          >
            <LocalizedText zh="个人简历" en="Resume / CV" />
          </a>
          <div class="flex items-center gap-4 ml-2">
            {SITE.social.github && (
              <a href={SITE.social.github} target="_blank" rel="noopener noreferrer" class="text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors" aria-label="GitHub">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              </a>
            )}
            {SITE.social.email && (
              <a href={`mailto:${SITE.social.email}`} class="text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors" aria-label="Email">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

---
import { SITE } from '../data/site';
---
<section id="about" class="py-24 bg-[var(--color-surface)] section-animate">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-12 items-center">
      <div class="md:col-span-2">
        <div class="relative">
          <div class="absolute -inset-4 bg-[var(--color-accent-bg)] -z-10 border border-[var(--color-accent-glow)]/20"></div>
          <img
            src="/images/avatar.jpg"
            alt={`Photo of ${SITE.name}`}
            class="w-full aspect-[4/5] object-cover"
            loading="lazy"
          />
        </div>
      </div>
      <div class="md:col-span-3">
        <h2 class="font-heading text-3xl font-bold uppercase tracking-wide mb-2">
          About Me
        </h2>
        <div class="w-12 h-0.5 bg-[var(--color-accent-light)] mb-8"></div>
        <p class="text-base leading-relaxed mb-4">{SITE.bio}</p>
        <p class="text-base leading-relaxed mb-4">{SITE.bioExtended}</p>
        <p class="text-base leading-relaxed mb-8 text-[var(--color-muted)]">{SITE.bioSide}</p>
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="/resume"
            target="_blank"
            class="inline-block bg-[var(--color-accent)] text-white px-6 py-2.5 text-sm font-medium uppercase tracking-wider hover:bg-[var(--color-accent-light)] border-2 border-[var(--color-accent)] hover:border-[var(--color-accent-light)] transition-all"
          >
            Resume / CV
          </a>
          <div class="flex items-center gap-4 ml-2">
            {SITE.social.github && (
              <a href={SITE.social.github} target="_blank" rel="noopener noreferrer" class="text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors" aria-label="GitHub">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              </a>
            )}
            {SITE.social.email && (
              <a href={`mailto:${SITE.social.email}`} class="text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors" aria-label="Email">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

---
import { SITE } from '../data/site';
import LocalizedText from './LocalizedText.astro';
import heroMedia from '../data/hero-media.json';

---
<section id="home" class="hero" aria-label="Introduction">
  <div class="hero-art" data-hero-background aria-hidden="true">
    <img src={heroMedia.posterDesktop} alt="" width="3840" height="2160" fetchpriority="high" />
    <video muted loop playsinline preload="none" tabindex="-1" disablepictureinpicture
      data-src={heroMedia.video}></video>
  </div>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-content">
    <p class="hero-greeting hero-enter"><LocalizedText zh="欢迎来到我的世界" en="Welcome to my world" /></p>
    <h1 class="hero-enter">{SITE.name}</h1>
    <p class="hero-tagline hero-enter"><LocalizedText zh="广告算法工程师。系统构建者。AI 探索者。" en={SITE.tagline} /></p>
    <p class="hero-interests hero-enter"><LocalizedText zh="程序化广告与实时竞价 / AI 基础设施 / Agent 系统与大模型 / 开源" en={SITE.subtitles.map((s) => s.replace(/\.$/, '')).join(' / ')} /></p>
  </div>
  <div class="hero-foot">
    <a href="#recent-posts" class="hero-explore"><LocalizedText zh="阅读文章" en="Explore the writing" /> <span aria-hidden="true">↓</span></a>
    <p>Per aspera ad astra.</p>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; display: flex; align-items: flex-end; min-height: 100vh; min-height: 100dvh; overflow: hidden; background: #0e4648; color: #f7f0e3; }
  .hero-art { position: absolute; z-index: -2; inset: -32px -16px; pointer-events: none; }
  .hero-art img, .hero-art video { display: block; width: 100%; height: 100%; }
  .hero-art img, .hero-art video { object-fit: cover; object-position: 50% 50%; }
  .hero-art video { position: absolute; inset: 0; opacity: 0; transition: opacity 600ms ease-out; }
  .hero[data-video-ready='true'] video { opacity: 1; }
  .hero-shade { position: absolute; z-index: -1; inset: 0; background: linear-gradient(180deg, rgb(4 28 32 / .42), rgb(4 28 32 / 0) 22%), linear-gradient(0deg, rgb(4 30 34 / .55), rgb(4 30 34 / 0) 32%), linear-gradient(90deg, rgb(5 36 40 / .50), rgb(5 36 40 / .24) 46%, rgb(5 36 40 / 0) 72%); }
  .hero-content { width: min(1152px, 100%); margin-inline: auto; padding: 168px 24px clamp(148px, 19vh, 208px); }
  .hero-greeting { margin-bottom: 28px; font-size: 11px; letter-spacing: .25em; text-transform: uppercase; color: rgb(247 240 227 / .86); }
  .hero h1 { margin: 0 0 30px -5px; font-family: var(--font-heading); font-size: clamp(64px, 10.5vw, 144px); line-height: 1; letter-spacing: -.065em; font-weight: 400; color: #f7f0e3; text-shadow: 0 1px 2px rgb(3 24 28 / .18), 0 10px 36px rgb(3 24 28 / .24); }
  .hero-tagline { max-width: 620px; font-size: clamp(16px, 1.6vw, 20px); line-height: 1.7; text-wrap: balance; }
  .hero-interests { max-width: 610px; margin-top: 16px; font-size: 12px; line-height: 1.9; color: #d9ece7; }
  .hero-greeting, .hero-tagline, .hero-interests { text-shadow: 0 1px 14px rgb(3 24 28 / .38); }
  .hero-enter { animation: hero-enter 450ms ease-out both; }
  h1.hero-enter { animation-delay: 70ms; }
  .hero-tagline.hero-enter { animation-delay: 140ms; }
  .hero-interests.hero-enter { animation-delay: 210ms; }
  .hero-foot { position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%); width: min(1104px, calc(100% - 48px)); display: flex; justify-content: space-between; align-items: center; gap: 24px; padding-top: 20px; border-top: 1px solid rgb(247 240 227 / .35); }
  .hero-explore { display: inline-flex; align-items: center; gap: 28px; font-size: 12px; letter-spacing: .03em; }
  .hero-explore span { font-size: 22px; transition: transform 180ms ease; }
  .hero-foot p { font-family: var(--font-heading); font-size: 16px; font-style: italic; }
  .hero-explore:focus-visible { outline: 2px solid #f7f0e3; outline-offset: 2px; }
  @media (hover: hover) { .hero-explore:hover span { transform: translateY(3px); } }
  @keyframes hero-enter { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-height: 620px) and (min-width: 768px) { .hero-content { padding-block: 112px 132px; } }
  @media (max-width: 767px) {
    .hero-art { inset: 0; }
    .hero-art img, .hero-art video { object-position: 84% 50%; }
    .hero-shade { background: linear-gradient(180deg, rgb(4 28 32 / .46), rgb(4 30 34 / .32) 28%, rgb(4 30 34 / .40) 62%, rgb(4 30 34 / .64)); }
    .hero-content { padding: 120px 20px 148px; }
    .hero h1 { font-size: clamp(40px, 13.6vw, 96px); margin-left: -2px; margin-bottom: 24px; letter-spacing: -.065em; }
    .hero-greeting { font-size: 10px; margin-bottom: 24px; }
    .hero-interests { max-width: 300px; font-size: 11px; }
    .hero-foot { bottom: 24px; }
    .hero-foot p { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-enter { animation: none; } .hero-explore span { transition: none; } }
</style>

<script>
  import { setupHeroMedia } from '../scripts/hero-media.mjs';
  const hero = document.getElementById('home');
  if (hero) setupHeroMedia(hero);
</script>

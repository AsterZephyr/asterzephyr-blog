---
interface Props {
  src: string;
  title?: string;
  caption?: string;
  alt?: string;
}

const { src, title, caption, alt = '' } = Astro.props;
---

<figure class="not-prose my-8">
  {title && (
    <div class="text-center mb-3">
      <span class="text-sm font-semibold uppercase tracking-wider text-[var(--color-muted)]">{title}</span>
    </div>
  )}
  <div class="overflow-x-auto rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-alt)] p-4">
    <img
      src={src}
      alt={alt || caption || title || ''}
      class="block mx-auto w-full max-w-[960px]"
      loading="lazy"
      decoding="async"
    />
  </div>
  {caption && (
    <figcaption class="mt-3 text-center text-sm text-[var(--color-muted)] italic">
      {caption}
    </figcaption>
  )}
</figure>

};

const Tag = href ? 'a' : 'div';
const iconSvg = icon && iconMap[icon] ? iconMap[icon] : null;
---

<Tag
  class:list={[
    'block rounded-lg border border-[var(--color-border)] p-5 bg-[var(--color-surface)] transition-all duration-200',
    href && 'hover:border-[var(--color-accent-light)] hover:shadow-md cursor-pointer no-underline',
  ]}
  {...(href ? { href } : {})}
>
  {iconSvg && (
    <div class="text-[var(--color-accent)] mb-3">
      <Fragment set:html={iconSvg} />
    </div>
  )}
  <h4 class="font-semibold text-[var(--color-heading)] mb-1 text-sm">{title}</h4>
  <div class="text-sm text-[var(--color-muted)] leading-relaxed card-content">
    <slot />
  </div>
</Tag>

<style>
  .card-content :global(p) {
    margin: 0;
  }
</style>

<script is:inline define:vars={{ uid }}>
  (function () {
    const root = document.getElementById(uid);
    if (!root) return;
    const copy = JSON.parse(root.dataset.copy || '{}');

    // Mode tabs
    const modeBtns = root.querySelectorAll('[data-mode]');
    const panels = root.querySelectorAll('[data-panel]');
    modeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-mode');
        modeBtns.forEach((b) => {
          const active = b.getAttribute('data-mode') === target;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        panels.forEach((p) => {
          p.classList.toggle('is-hidden', p.getAttribute('data-panel') !== target);
        });
      });
    });

    // --- Mode 1: GRPO vs NGU ---
    const inHardShare = root.querySelector('[data-in="hardShare"]');
    const inHardPass = root.querySelector('[data-in="hardPass"]');
    const inProbP = root.querySelector('[data-in="probP"]');

    function evalNguPrompt(passRate, pExpand) {
      // Discrete stages: 4, 8, 12, ..., 32 (max 8 chunks of 4)
      let survAllWrong = 1;
      let expRollouts = 0;
      let probZeroGrad = 0;
      let probHit = 0;
      const allPass4 = Math.pow(passRate, 4);
      const allWrong4 = Math.pow(1 - passRate, 4);

      // Stage 1: always sample 4
      expRollouts += 4;
      probZeroGrad += allPass4; // all 4 right -> filtered after 4, 0 gradient
      const mixed1 = 1 - allPass4 - allWrong4;
      probHit += allPass4 + mixed1;
      survAllWrong = allWrong4;

      for (let stage = 2; stage <= 8; stage++) {
        // Expand with probability pExpand; stop with (1 - pExpand) as all-wrong (0 gradient)
        probZeroGrad += survAllWrong * (1 - pExpand);
        const cont = survAllWrong * pExpand;
        expRollouts += cont * 4;
        const hitNow = cont * (1 - allWrong4);
        probHit += hitNow;
        survAllWrong = cont * allWrong4;
      }
      // After max cap 32, remaining all-wrong has 0 gradient
      probZeroGrad += survAllWrong;

      // Expected rollouts that end up in a zero-gradient group (approximate by probability-weighted share)
      const zeroRollouts =
        allPass4 * 4 +
        (function () {
          let w = allWrong4;
          let zR = 0;
          for (let stage = 2; stage <= 8; stage++) {
            zR += w * (1 - pExpand) * ((stage - 1) * 4);
            w = w * pExpand * allWrong4;
          }
          zR += w * 32;
          return zR;
        })();

      return { expRollouts, zeroRollouts, probHit, probZeroGrad };
    }

    function updateNgu() {
      const hardShare = Number(inHardShare.value) / 100;
      const rem = 1 - hardShare;
      const easyShare = rem * 0.55;
      const midShare = rem * 0.45;
      const pHard = Number(inHardPass.value) / 100;
      const pExpand = Number(inProbP.value) / 100;
      const pEasy = 0.96;
      const pMid = 0.45;

      root.querySelector('[data-out="hardShare"]').textContent = `${Math.round(hardShare * 100)}%`;
      root.querySelector('[data-out="hardPass"]').textContent = `${Math.round(pHard * 100)}%`;
      root.querySelector('[data-out="probP"]').textContent = pExpand.toFixed(2);

      // Vanilla GRPO: fixed 16 rollouts each
      const g = 16;
      const zeroE = Math.pow(pEasy, g) + Math.pow(1 - pEasy, g);
      const zeroM = Math.pow(pMid, g) + Math.pow(1 - pMid, g);
      const zeroH = Math.pow(pHard, g) + Math.pow(1 - pHard, g);
      const grpoZeroShare = easyShare * zeroE + midShare * zeroM + hardShare * zeroH;
      const grpoMidActive = easyShare * (1 - zeroE) + midShare * (1 - zeroM);
      const grpoHardActive = hardShare * (1 - zeroH);
      const grpoHardHit = 1 - Math.pow(1 - pHard, g);

      // NGU
      const rE = evalNguPrompt(pEasy, pExpand);
      const rM = evalNguPrompt(pMid, pExpand);
      const rH = evalNguPrompt(pHard, pExpand);
      const totalRoll = easyShare * rE.expRollouts + midShare * rM.expRollouts + hardShare * rH.expRollouts;
      const totalZeroRoll = easyShare * rE.zeroRollouts + midShare * rM.zeroRollouts + hardShare * rH.zeroRollouts;
      const nguZeroShare = totalZeroRoll / totalRoll;
      const nguMidActive =
        (easyShare * (rE.expRollouts - rE.zeroRollouts) + midShare * (rM.expRollouts - rM.zeroRollouts)) / totalRoll;
      const nguHardActive = (hardShare * (rH.expRollouts - rH.zeroRollouts)) / totalRoll;
      const nguHardRollShare = (hardShare * rH.expRollouts) / totalRoll;

      root.querySelector('[data-m="grpoZero"]').textContent = `${(grpoZeroShare * 100).toFixed(1)}%`;
      root.querySelector('[data-m="grpoHardShare"]').textContent = `${(hardShare * 100).toFixed(1)}%`;
      root.querySelector('[data-m="grpoHardHit"]').textContent = `${(grpoHardHit * 100).toFixed(1)}%`;
      root.querySelector('[data-m="grpoAvg"]').textContent = g.toFixed(1);

      root.querySelector('[data-m="nguZero"]').textContent = `${(nguZeroShare * 100).toFixed(1)}%`;
      root.querySelector('[data-m="nguHardShare"]').textContent = `${(nguHardRollShare * 100).toFixed(1)}%`;
      root.querySelector('[data-m="nguHardHit"]').textContent = `${(rH.probHit * 100).toFixed(1)}%`;
      root.querySelector('[data-m="nguAvg"]').textContent = totalRoll.toFixed(1);

      const gBar = root.querySelector('[data-bar="grpo"]').children;
      gBar[0].style.width = `${(grpoZeroShare * 100).toFixed(1)}%`;
      gBar[1].style.width = `${(grpoMidActive * 100).toFixed(1)}%`;
      gBar[2].style.width = `${(grpoHardActive * 100).toFixed(1)}%`;

      const nBar = root.querySelector('[data-bar="ngu"]').children;
      nBar[0].style.width = `${(nguZeroShare * 100).toFixed(1)}%`;
      nBar[1].style.width = `${(nguMidActive * 100).toFixed(1)}%`;
      nBar[2].style.width = `${(nguHardActive * 100).toFixed(1)}%`;
    }

    root.querySelectorAll('[data-ngu-preset]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-ngu-preset');
        const preset = copy.ngu.presets.find((x) => x.id === id);
        if (!preset) return;
        root.querySelectorAll('[data-ngu-preset]').forEach((b) => b.classList.toggle('is-active', b === btn));
        inHardShare.value = String(preset.hardShare);
        inHardPass.value = String(preset.hardPass);
        inProbP.value = String(preset.probP);
        updateNgu();
      });
    });
    [inHardShare, inHardPass, inProbP].forEach((el) => el.addEventListener('input', updateNgu));
    updateNgu();

    // --- Mode 2: ScaleRL Sigmoidal ---
    const inAB = root.querySelector('[data-in="aB"]');
    const inMidB = root.querySelector('[data-in="midB"]');
    const inBudgetLog = root.querySelector('[data-in="budgetLog"]');
    let slopeB = 0.72;
    const R0 = 0.15;
    const aA = 0.72;
    const midA = 1200;
    const slopeA = 0.90;

    function sigR(C, A, Cmid, B) {
      return R0 + (A - R0) / (1 + Math.pow(Cmid / C, B));
    }
    function xFromLogC(logC) {
      // log10(C) in [2, 5] -> x in [56, 616]
      return 56 + ((logC - 2) / 3) * 560;
    }
    function yFromR(r) {
      // r in [0.15, 0.95] -> y in [188, 28]
      return 188 - ((r - 0.15) / 0.80) * 160;
    }

    function updateScale() {
      const aB = Number(inAB.value) / 100;
      const midB = Number(inMidB.value);
      const logC = Number(inBudgetLog.value) / 10;
      const C = Math.pow(10, logC);

      root.querySelector('[data-out="aB"]').textContent = aB.toFixed(2);
      root.querySelector('[data-out="midB"]').textContent = midB.toLocaleString('en-US');
      root.querySelector('[data-out="budget"]').textContent = Math.round(C).toLocaleString('en-US');

      let dA = '';
      let dB = '';
      let crossC = null;
      let prevDiff = null;
      const steps = 60;
      for (let i = 0; i <= steps; i++) {
        const lc = 2 + (3 * i) / steps;
        const cVal = Math.pow(10, lc);
        const rA = sigR(cVal, aA, midA, slopeA);
        const rB = sigR(cVal, aB, midB, slopeB);
        const x = xFromLogC(lc).toFixed(1);
        const yA = yFromR(rA).toFixed(1);
        const yB = yFromR(rB).toFixed(1);
        dA += (i === 0 ? 'M' : 'L') + `${x} ${yA} `;
        dB += (i === 0 ? 'M' : 'L') + `${x} ${yB} `;
        const diff = rB - rA;
        if (prevDiff !== null && ((prevDiff < 0 && diff >= 0) || (prevDiff > 0 && diff <= 0)) && crossC === null) {
          const frac = Math.abs(prevDiff) / (Math.abs(prevDiff) + Math.abs(diff));
          const prevLc = 2 + (3 * (i - 1)) / steps;
          crossC = Math.pow(10, prevLc + frac * (3 / steps));
        }
        prevDiff = diff;
      }

      root.querySelector('[data-el="curveA"]').setAttribute('d', dA);
      root.querySelector('[data-el="curveB"]').setAttribute('d', dB);
      root.querySelector('[data-el="asymA"]').setAttribute('y1', yFromR(aA).toFixed(1));
      root.querySelector('[data-el="asymA"]').setAttribute('y2', yFromR(aA).toFixed(1));
      root.querySelector('[data-el="asymB"]').setAttribute('y1', yFromR(aB).toFixed(1));
      root.querySelector('[data-el="asymB"]').setAttribute('y2', yFromR(aB).toFixed(1));

      const xB = xFromLogC(logC);
      const rAcur = sigR(C, aA, midA, slopeA);
      const rBcur = sigR(C, aB, midB, slopeB);
      root.querySelector('[data-el="budgetLine"]').setAttribute('x1', xB.toFixed(1));
      root.querySelector('[data-el="budgetLine"]').setAttribute('x2', xB.toFixed(1));
      root.querySelector('[data-el="dotA"]').setAttribute('cx', xB.toFixed(1));
      root.querySelector('[data-el="dotA"]').setAttribute('cy', yFromR(rAcur).toFixed(1));
      root.querySelector('[data-el="dotB"]').setAttribute('cx', xB.toFixed(1));
      root.querySelector('[data-el="dotB"]').setAttribute('cy', yFromR(rBcur).toFixed(1));

      const dotCross = root.querySelector('[data-el="dotCross"]');
      if (crossC !== null) {
        const cx = xFromLogC(Math.log10(crossC));
        const cy = yFromR(sigR(crossC, aA, midA, slopeA));
        dotCross.setAttribute('cx', cx.toFixed(1));
        dotCross.setAttribute('cy', cy.toFixed(1));
        dotCross.style.display = '';
        root.querySelector('[data-m="valCross"]').textContent = `~${Math.round(crossC).toLocaleString('en-US')} GPU-h`;
      } else {
        dotCross.style.display = 'none';
        root.querySelector('[data-m="valCross"]').textContent = copy.scalerl.noCross;
      }

      root.querySelector('[data-m="valA"]').textContent = rAcur.toFixed(3);
      root.querySelector('[data-m="valB"]').textContent = rBcur.toFixed(3);
      root.querySelector('[data-m="verdict"]').textContent =
        rBcur >= rAcur ? copy.scalerl.verdictHigherB : copy.scalerl.verdictHigherA;
    }

    root.querySelectorAll('[data-scale-preset]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-scale-preset');
        const preset = copy.scalerl.presets.find((x) => x.id === id);
        if (!preset) return;
        root.querySelectorAll('[data-scale-preset]').forEach((b) => b.classList.toggle('is-active', b === btn));
        inAB.value = String(preset.aB);
        inMidB.value = String(preset.midB);
        slopeB = preset.slopeB;
        inBudgetLog.value = String(Math.round(Math.log10(preset.budget) * 10));
        updateScale();
      });
    });
    [inAB, inMidB, inBudgetLog].forEach((el) => el.addEventListener('input', updateScale));
    updateScale();
  })();
</script>


---
interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;
const isZh = lang === 'zh';

const copy = isZh
  ? {
      eyebrow: '交互式实验器 · RL 算力分配与 S 型缩放曲线',
      title: '动手调参，直观对比 GRPO 固定批浪费与 ScaleRL 天花板交叉',
      subtitle:
        '顶部切换两个后训练核心权衡：一是普通 GRPO 与 Never Give Up (NGU) 在不同题难分布下的有效梯度分配，二是 ScaleRL S 型曲线里渐近上限 A 与效率中点如何引发大小算力反超。',
      modeLabel: '实验模式',
      modes: [
        { id: 'ngu', label: '1. GRPO vs NGU 动态采样分配' },
        { id: 'scalerl', label: '2. ScaleRL S 型缩放交叉' },
      ],
      ngu: {
        presetLabel: '典型场景预设',
        presets: [
          { id: 'aime', label: '竞赛数学混合批', hardShare: 25, hardPass: 6, probP: 85 },
          { id: 'coding', label: '多测例编程难题批', hardShare: 50, hardPass: 5, probP: 95 },
          { id: 'cold', label: '冷启动偏弱基座', hardShare: 60, hardPass: 3, probP: 80 },
        ],
        sliderHardShare: '难题在批次中的占比',
        sliderHardPass: '单次采样命中难题的概率',
        sliderProbP: 'NGU 全错继续扩批的概率 p',
        grpoTitle: '普通 GRPO（每题固定 16 条采样）',
        nguTitle: 'Never Give Up（4 起步，全错按 p 扩批至上限 32）',
        metricZeroGrad: '零梯度算力占比（全对 + 全错）',
        metricHardShare: '总采样预算流向难题的比例',
        metricHardHit: '单道难题至少拿到 1 个正样本的概率',
        metricAvgRollouts: '每题平均采样条数',
        barZero: '零梯度浪费',
        barEasyMid: '简单/中等有效梯度',
        barHardHit: '难题有效梯度',
        note: '教学算力分配模型：假设简单题单次通过率 0.96、中等题 0.45，按 Noukhovitch et al. (2026) 的 4→8→...→32 扩批机制做离散期望计算，用于展示预算转移方向，非特定模型实测值。',
      },
      scalerl: {
        presetLabel: '缩放对照预设',
        presets: [
          { id: 'cross', label: '高上限慢爬坡 vs 低上限快起飞', aB: 84, midB: 3200, slopeB: 0.72, budget: 25000 },
          { id: 'eff', label: '同上限、效率加倍（数据/损失改进）', aB: 72, midB: 600, slopeB: 0.90, budget: 6000 },
          { id: 'sat', label: '进入渐近平台后的边际骤降', aB: 82, midB: 2000, slopeB: 0.80, budget: 80000 },
        ],
        sliderAsym: '配方 B 渐近上限 A（基准配方 A 固定为 0.72）',
        sliderMid: '配方 B 爬坡中点算力 C_mid（GPU-hours，配方 A 为 1,200）',
        sliderBudget: '当前验收算力预算 C（GPU-hours，对数刻度）',
        legendA: '配方 A（快起飞，A=0.72, C_mid=1,200）',
        legendB: '配方 B（可调上限与中点）',
        axisX: 'RL 算力预算 C（GPU-hours，对数轴）',
        axisY: '期望验证奖励 R(C)',
        readoutA: '当前预算下配方 A',
        readoutB: '当前预算下配方 B',
        readoutCross: '两条曲线交叉点',
        noCross: '区间内未交叉',
        verdictHigherB: '大算力下高上限配方已反超：如果在小算力阶段提前下结论，会误杀更高上限的方案。',
        verdictHigherA: '当前算力仍偏早：快起飞配方暂时领先，但继续加卡后可能撞上更低的渐近天花板。',
        note: '教学示意曲线：基于 Khatri et al. (2025) ScaleRL 的 S 型函数 R(C) = R0 + (A - R0) / (1 + (C_mid / C)^B) 绘制（固定 R0 = 0.15），用于直观看懂上限 A 与效率 C_mid 的分离，非具体基准实测点。',
      },
    }
  : {
      eyebrow: 'INTERACTIVE LAB · RL COMPUTE ALLOCATION & SIGMOIDAL SCALING',
      title: 'Explore GRPO Fixed-Batch Waste vs. ScaleRL Asymptote Crossovers',
      subtitle:
        'Toggle two central post-training trade-offs: how Never Give Up (NGU) reallocates rollouts away from zero-gradient prompts, and how separating asymptote A from compute midpoint C_mid flips small-scale rankings.',
      modeLabel: 'Lab Mode',
      modes: [
        { id: 'ngu', label: '1. GRPO vs. NGU Rollout Allocation' },
        { id: 'scalerl', label: '2. ScaleRL Sigmoidal Crossover' },
      ],
      ngu: {
        presetLabel: 'Batch Presets',
        presets: [
          { id: 'aime', label: 'Math Mix (AIME-like)', hardShare: 25, hardPass: 6, probP: 85 },
          { id: 'coding', label: 'Hard Coding Tests (Manufactoria-like)', hardShare: 50, hardPass: 5, probP: 95 },
          { id: 'cold', label: 'Weak Cold-Start Policy', hardShare: 60, hardPass: 3, probP: 80 },
        ],
        sliderHardShare: 'Share of hard prompts in batch',
        sliderHardPass: 'Per-rollout pass probability on hard prompts',
        sliderProbP: 'NGU expansion probability p when all rollouts fail',
        grpoTitle: 'Vanilla GRPO (Fixed 16 rollouts / prompt)',
        nguTitle: 'Never Give Up (Start at 4, expand +4 with prob p, cap 32)',
        metricZeroGrad: 'Zero-gradient rollout share (all-pass + all-fail)',
        metricHardShare: 'Share of total rollouts spent on hard prompts',
        metricHardHit: 'Probability a hard prompt gets >=1 positive sample',
        metricAvgRollouts: 'Mean rollouts per prompt',
        barZero: 'Zero-gradient waste',
        barEasyMid: 'Easy/medium active gradient',
        barHardHit: 'Hard prompt active gradient',
        note: 'Teaching allocation simulator: assumes per-rollout pass rates of 0.96 (easy) and 0.45 (medium), using the 4->8->...->32 dynamic expansion rule from Noukhovitch et al. (2026). Illustrates budget dynamics rather than measured benchmark numbers.',
      },
      scalerl: {
        presetLabel: 'Scaling Presets',
        presets: [
          { id: 'cross', label: 'Higher Ceiling, Slower Start', aB: 84, midB: 3200, slopeB: 0.72, budget: 25000 },
          { id: 'eff', label: 'Same Ceiling, 2x Efficiency', aB: 72, midB: 600, slopeB: 0.90, budget: 6000 },
          { id: 'sat', label: 'Near Asymptotic Plateau', aB: 82, midB: 2000, slopeB: 0.80, budget: 80000 },
        ],
        sliderAsym: 'Recipe B asymptote A (Baseline Recipe A fixed at 0.72)',
        sliderMid: 'Recipe B compute midpoint C_mid (GPU-hours; Recipe A = 1,200)',
        sliderBudget: 'Evaluation compute budget C (GPU-hours, log scale)',
        legendA: 'Recipe A (Fast start, A=0.72, C_mid=1,200)',
        legendB: 'Recipe B (Adjustable ceiling & midpoint)',
        axisX: 'RL compute budget C (GPU-hours, log axis)',
        axisY: 'Expected validation reward R(C)',
        readoutA: 'Recipe A at budget C',
        readoutB: 'Recipe B at budget C',
        readoutCross: 'Crossover point',
        noCross: 'No crossover in range',
        verdictHigherB: 'Higher-ceiling recipe leads at scale: judging from a small pilot run would have discarded the better asymptote.',
        verdictHigherA: 'Still in the early compute regime: the fast-start recipe leads today, though it may cap out lower with more GPUs.',
        note: 'Teaching curve: plots the sigmoidal form R(C) = R0 + (A - R0) / (1 + (C_mid / C)^B) from Khatri et al. (2025) with R0 = 0.15. Demonstrates how asymptote A and efficiency midpoint C_mid separate, not specific benchmark measurements.',
      },
    };

const uid = `ptl-${Math.random().toString(36).slice(2, 8)}`;
---

<section class="ptl-box not-prose" id={uid} data-lang={lang} data-copy={JSON.stringify(copy)}>
  <header class="ptl-head">
    <p class="ptl-eyebrow">{copy.eyebrow}</p>
    <h3 class="ptl-title">{copy.title}</h3>
    <p class="ptl-subtitle">{copy.subtitle}</p>
  </header>

  <div class="ptl-mode-row">
    <span class="ptl-label">{copy.modeLabel}</span>
    <div class="ptl-pills" role="tablist">
      {copy.modes.map((m, idx) => (
        <button
          type="button"
          class:list={['ptl-pill', { 'is-active': idx === 0 }]}
          data-mode={m.id}
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
        >
          {m.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Mode 1: GRPO vs NGU -->
  <div class="ptl-panel" data-panel="ngu">
    <div class="ptl-preset-row">
      <span class="ptl-label">{copy.ngu.presetLabel}</span>
      <div class="ptl-tabs">
        {copy.ngu.presets.map((p, idx) => (
          <button
            type="button"
            class:list={['ptl-tab', { 'is-active': idx === 1 }]}
            data-ngu-preset={p.id}
          >
            {p.label}
          </button>
        ))}
      </div>
    </div>

    <div class="ptl-sliders">
      <label class="ptl-slider-item">
        <span class="ptl-slider-top">
          <span>{copy.ngu.sliderHardShare}</span>
          <strong data-out="hardShare">50%</strong>
        </span>
        <input type="range" min="10" max="70" step="5" value="50" data-in="hardShare" />
      </label>
      <label class="ptl-slider-item">
        <span class="ptl-slider-top">
          <span>{copy.ngu.sliderHardPass}</span>
          <strong data-out="hardPass">5%</strong>
        </span>
        <input type="range" min="1" max="15" step="1" value="5" data-in="hardPass" />
      </label>
      <label class="ptl-slider-item">
        <span class="ptl-slider-top">
          <span>{copy.ngu.sliderProbP}</span>
          <strong data-out="probP">0.95</strong>
        </span>
        <input type="range" min="30" max="100" step="5" value="95" data-in="probP" />
      </label>
    </div>

    <div class="ptl-grid">
      <div class="ptl-card ptl-card-terra">
        <h4 class="ptl-card-head">{copy.ngu.grpoTitle}</h4>
        <div class="ptl-bar-track" data-bar="grpo" aria-label="GRPO rollout breakdown">
          <span class="ptl-seg-zero" style="width: 48%"></span>
          <span class="ptl-seg-mid" style="width: 24%"></span>
          <span class="ptl-seg-hard" style="width: 28%"></span>
        </div>
        <dl class="ptl-metrics">
          <div><dt>{copy.ngu.metricZeroGrad}</dt><dd data-m="grpoZero">47.5%</dd></div>
          <div><dt>{copy.ngu.metricHardShare}</dt><dd data-m="grpoHardShare">50.0%</dd></div>
          <div><dt>{copy.ngu.metricHardHit}</dt><dd data-m="grpoHardHit">56.0%</dd></div>
          <div><dt>{copy.ngu.metricAvgRollouts}</dt><dd data-m="grpoAvg">16.0</dd></div>
        </dl>
      </div>

      <div class="ptl-card ptl-card-teal">
        <h4 class="ptl-card-head">{copy.ngu.nguTitle}</h4>
        <div class="ptl-bar-track" data-bar="ngu" aria-label="NGU rollout breakdown">
          <span class="ptl-seg-zero" style="width: 26%"></span>
          <span class="ptl-seg-mid" style="width: 14%"></span>
          <span class="ptl-seg-hard" style="width: 60%"></span>
        </div>
        <dl class="ptl-metrics">
          <div><dt>{copy.ngu.metricZeroGrad}</dt><dd data-m="nguZero">29.4%</dd></div>
          <div><dt>{copy.ngu.metricHardShare}</dt><dd data-m="nguHardShare">79.2%</dd></div>
          <div><dt>{copy.ngu.metricHardHit}</dt><dd data-m="nguHardHit">72.4%</dd></div>
          <div><dt>{copy.ngu.metricAvgRollouts}</dt><dd data-m="nguAvg">12.6</dd></div>
        </dl>
      </div>
    </div>

    <div class="ptl-legend">
      <span><i class="ptl-dot ptl-seg-zero"></i>{copy.ngu.barZero}</span>
      <span><i class="ptl-dot ptl-seg-mid"></i>{copy.ngu.barEasyMid}</span>
      <span><i class="ptl-dot ptl-seg-hard"></i>{copy.ngu.barHardHit}</span>
    </div>
    <p class="ptl-note">{copy.ngu.note}</p>
  </div>

  <!-- Mode 2: ScaleRL Sigmoidal Curve -->
  <div class="ptl-panel is-hidden" data-panel="scalerl">
    <div class="ptl-preset-row">
      <span class="ptl-label">{copy.scalerl.presetLabel}</span>
      <div class="ptl-tabs">
        {copy.scalerl.presets.map((p, idx) => (
          <button
            type="button"
            class:list={['ptl-tab', { 'is-active': idx === 0 }]}
            data-scale-preset={p.id}
          >
            {p.label}
          </button>
        ))}
      </div>
    </div>

    <div class="ptl-sliders">
      <label class="ptl-slider-item">
        <span class="ptl-slider-top">
          <span>{copy.scalerl.sliderAsym}</span>
          <strong data-out="aB">0.84</strong>
        </span>
        <input type="range" min="62" max="92" step="1" value="84" data-in="aB" />
      </label>
      <label class="ptl-slider-item">
        <span class="ptl-slider-top">
          <span>{copy.scalerl.sliderMid}</span>
          <strong data-out="midB">3,200</strong>
        </span>
        <input type="range" min="400" max="8000" step="200" value="3200" data-in="midB" />
      </label>
      <label class="ptl-slider-item">
        <span class="ptl-slider-top">
          <span>{copy.scalerl.sliderBudget}</span>
          <strong data-out="budget">25,000</strong>
        </span>
        <input type="range" min="20" max="50" step="1" value="44" data-in="budgetLog" />
      </label>
    </div>

    <div class="ptl-chart-wrap">
      <svg class="ptl-svg" viewBox="0 0 640 245" role="img" aria-label={copy.scalerl.axisY}>
        <rect x="0" y="0" width="640" height="245" fill="#fffdf9" rx="6" />
        <!-- Grid lines -->
        <line x1="56" y1="28" x2="616" y2="28" stroke="#ece6dc" stroke-width="1" />
        <line x1="56" y1="68" x2="616" y2="68" stroke="#ece6dc" stroke-width="1" />
        <line x1="56" y1="108" x2="616" y2="108" stroke="#ece6dc" stroke-width="1" />
        <line x1="56" y1="148" x2="616" y2="148" stroke="#ece6dc" stroke-width="1" />
        <line x1="56" y1="188" x2="616" y2="188" stroke="#d9d1c4" stroke-width="1.2" />
        <line x1="56" y1="20" x2="56" y2="188" stroke="#d9d1c4" stroke-width="1.2" />

        <!-- Y ticks -->
        <text x="48" y="32" font-size="10.5" fill="#6d665d" text-anchor="end">0.95</text>
        <text x="48" y="72" font-size="10.5" fill="#6d665d" text-anchor="end">0.75</text>
        <text x="48" y="112" font-size="10.5" fill="#6d665d" text-anchor="end">0.55</text>
        <text x="48" y="152" font-size="10.5" fill="#6d665d" text-anchor="end">0.35</text>
        <text x="48" y="192" font-size="10.5" fill="#6d665d" text-anchor="end">0.15</text>

        <!-- X ticks (10^2 .. 10^5) -->
        <text x="56" y="206" font-size="10.5" fill="#6d665d" text-anchor="middle">100</text>
        <text x="242" y="206" font-size="10.5" fill="#6d665d" text-anchor="middle">1,000</text>
        <text x="429" y="206" font-size="10.5" fill="#6d665d" text-anchor="middle">10,000</text>
        <text x="616" y="206" font-size="10.5" fill="#6d665d" text-anchor="middle">100,000</text>
        <text x="336" y="229" font-size="11" fill="#5d574f" text-anchor="middle">{copy.scalerl.axisX}</text>

        <!-- Asymptote dashed guides -->
        <line data-el="asymA" x1="56" y1="74" x2="616" y2="74" stroke="#b1462f" stroke-width="1" stroke-dasharray="4 4" opacity="0.55" />
        <line data-el="asymB" x1="56" y1="50" x2="616" y2="50" stroke="#2c6b5a" stroke-width="1" stroke-dasharray="4 4" opacity="0.55" />

        <!-- Budget vertical line -->
        <line data-el="budgetLine" x1="504" y1="22" x2="504" y2="188" stroke="#1f1d1a" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.6" />

        <!-- Curves -->
        <path data-el="curveA" d="M56 178 Q242 132 429 84 T616 75" fill="none" stroke="#b1462f" stroke-width="2.5" />
        <path data-el="curveB" d="M56 182 Q242 152 429 88 T616 56" fill="none" stroke="#2c6b5a" stroke-width="2.5" />

        <!-- Points at current budget -->
        <circle data-el="dotA" cx="504" cy="80" r="4.5" fill="#b1462f" />
        <circle data-el="dotB" cx="504" cy="68" r="4.5" fill="#2c6b5a" />
        <circle data-el="dotCross" cx="380" cy="96" r="4.5" fill="#d97706" stroke="#fff" stroke-width="1.5" />
      </svg>
    </div>

    <div class="ptl-legend">
      <span><i class="ptl-dot ptl-dot-terra"></i>{copy.scalerl.legendA}</span>
      <span><i class="ptl-dot ptl-dot-teal"></i>{copy.scalerl.legendB}</span>

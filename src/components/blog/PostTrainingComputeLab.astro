    <div class="ptl-readout-row">
      <div class="ptl-stat"><span>{copy.scalerl.readoutA}</span><strong data-m="valA">0.69</strong></div>
      <div class="ptl-stat"><span>{copy.scalerl.readoutB}</span><strong data-m="valB">0.72</strong></div>
      <div class="ptl-stat"><span>{copy.scalerl.readoutCross}</span><strong data-m="valCross">~7,900 GPU-h</strong></div>
    </div>
    <p class="ptl-verdict" data-m="verdict">{copy.scalerl.verdictHigherB}</p>
    <p class="ptl-note">{copy.scalerl.note}</p>

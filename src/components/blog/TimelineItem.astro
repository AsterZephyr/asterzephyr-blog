---
interface Props {
  date?: string;
  label?: string;
  active?: boolean;
}

const { date, label, active = false } = Astro.props;
---

<div class="timeline-item grid gap-x-4 pb-8" style="grid-template-columns: 5rem 1.5rem 1fr;">
  <div class="text-right pt-0.5">
    {date && <div class="text-xs font-mono text-[var(--color-muted)]">{date}</div>}
    {label && <div class={`text-sm font-semibold ${active ? 'text-[var(--color-accent)]' : 'text-[var(--color-heading)]'}`}>{label}</div>}
  </div>
  <div class="flex flex-col items-center">
    <div class={`w-3 h-3 rounded-full shrink-0 mt-1.5 ${active ? 'bg-[var(--color-accent)] ring-4 ring-[var(--color-accent-bg)]' : 'bg-[var(--color-border)]'}`}></div>
    <div class="timeline-line flex-1 w-0.5 bg-[var(--color-border)] mt-1"></div>
  </div>
  <div class="pt-0.5">
    <div class="timeline-content text-sm leading-relaxed text-[var(--color-body)]">
      <slot />
    </div>
  </div>
</div>

<style>
  .timeline-item:last-child .timeline-line {
    display: none;
  }
  .timeline-item:last-child {
    padding-bottom: 0;
  }
  .timeline-content :global(p) {
    margin: 0;
  }
  .timeline-content :global(p + p) {
    margin-top: 0.5rem;
  }
</style>

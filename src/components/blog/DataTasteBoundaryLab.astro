---
interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;
const isZh = lang === 'zh';

const copy = isZh
  ? {
      eyebrow: '开工前速查 · 你的情况该怎么挑数据',
      title: '先选清楚“缺卡还是缺数据”和“训到哪一步”，直接看该干什么、别踩什么坑',
      subtitle:
        '切一下你手头的资源现状和训练阶段，两边会立刻给出对应的一手论文做法、花小钱就能跑通的验数办法，以及最容易踩的坑。',
      regimeLabel: '你现在缺什么',
      stageLabel: '训到哪一步',
      leftHead: '这种情况最稳的做法',
      rightHead: '最容易踩的坑',
      labelLever: '重点干什么',
      labelSignal: '花小钱怎么验',
      labelAnchor: '论文出处',
      labelTrap: '常见翻车点',
      labelRedFlag: '开工前警报信号',
      regimes: [
        { id: 'compute', label: '缺卡（数据够多，GPU 紧张）' },
        { id: 'data', label: '缺数据（池子固定，快训重复了）' },
      ],
      stages: [
        { id: 'pretrain', label: '预训练 Pre-train' },
        { id: 'midtrain', label: '退火 / 长上下文' },
        { id: 'sft', label: 'SFT 教规矩' },
        { id: 'rl', label: 'RL 与 Agent 造数据' },
      ],
      cells: {
        'compute:pretrain': {
          lever: '按单个快照各自去重，再过一遍轻量语义分类器，把垃圾和重复先清掉',
          signal: '用 150M 小模型跑两份语料对比，看正确答案的连续概率（Correct Prob / Total Prob）排先后',
          anchor: 'Chinchilla · CCNet · FineWeb (15T) · DataMan (1.5B) · DataDecide',
          whyTitle: '为什么缺卡时先做减法最划算',
          why: '手头的网页多到集群根本吃不完，把有限的 GPU 时间集中喂给干净、有料的样本，涨分最直接。',
          traps: [
            '跨 96 个历史快照一起去重，会把老网页里反复出现的优质常青内容删空，反倒让广告和垃圾页占比变高（FineWeb）。',
            '拿小模型测代码集时死盯“做对了多少题”（准确率几乎全 0），很容易把真正有用的代码语料误杀。',
          ],
          redFlag: '去重后如果早期快照被砍掉 80% 以上，先抽样对比“留下的 10%”和“删掉的 90%”，别急着全量上线。',
        },
        'compute:midtrain': {
          lever: '退火期集中拉高数学、代码和推理占比；拉长上下文时，坚持把超长文和常规短文混着训',
          signal: '同时盯住常规 4k 评测和长文档多篇检索（答案必须能自动判对错）',
          anchor: 'Nemotron 3 Nano Phase 2 (1.5T) + 121B Long-Context (512k/4k 混训)',
          whyTitle: '退火期是最省钱的提分窗口',
          why: '不用重训前面 20T 主语料，只在最后 5% 到 10% 的 token 预算里换成高纯度数据，就能把推理和长窗拉起来。',
          traps: [
            '扩长上下文时只喂 512k 超长序列，结果长文会读了，平时最常用的短对话基础分却往下掉（Nemotron 3）。',
            '把退火期当成 SFT，塞满格式化对话模板却没留够高质量知识回放，模型泛化会变脆。',
          ],
          redFlag: '长窗任务涨分了，但常规 4k 评测掉了 1 分以上，说明短文本回放比例（例如 Nemotron 留的 79% Phase 2 下采样）给少了。',
        },
        'compute:sft': {
          lever: '想让模型线上听指挥（开关思考、预算截断、调工具），必须提前写进 SFT 样本；池子到了百万级，改用模型自己的隐状态挑数据',
          signal: '池子放大后必跑“随机采样”对照基线，再用待微调基座的隐状态和验证题做 RDS+ 相似度匹配',
          anchor: 'Nemotron 3 Nano (§3.1.5 10%/3% 协议) · DEITA (小池) · RDS+ (5.8M 大池)',
          whyTitle: 'SFT 教的是“怎么干活”，不是背百科',
          why: '线上预算到了强行截断思考还能好好作答，靠的是 SFT 里专门训过截断收敛样本，不是上线时临时硬掐。',
          traps: [
            '候选池从 10 万扩到几百万后，还用 Perplexity、IFD 或外部打分器挑数据，容易被怪样本钻空子，成绩甚至不如随机抽（Ivison et al.）。',
            'SFT 全是完整长思考，线上用户设了长度上限强行塞 </think> 时，模型直接乱答或卡死。',
          ],
          redFlag: '大池子里挑出来的数据，只要跑不赢“同预算随机采样 + 去重”，立刻停掉外置打分器。',
        },
        'compute:rl': {
          lever: '先拿少量高质量 SFT 把格式稳住，再用隐藏验证器防作弊，按通过率把太简单和太难的题筛掉',
          signal: '每题采样 8 条作答，踢掉 8/8 全对和 0/8 全错的题，只把算力留给“有的对、有的错”的题',
          anchor: 'DeepSeek-R1 · Kimi K3 (AET 隔离验证器) · WeAgent-MMSearch (4.9K 精选)',
          whyTitle: 'RL 最怕把卡烧在没梯度的题和刷分漏洞上',
          why: '全对的题已经没涨分空间，全错的题学不到正例子；不藏好验证测试，模型会优先学会钻测试漏洞。',
          traps: [
            '不做冷启动 SFT 直接纯 RL，模型容易中英乱串、输出可读性崩坏（DeepSeek-R1-Zero）。',
            '多模态题面或网页 URL 偷偷漏了答案，模型压根没看图片，纯靠猜文字就把奖励刷满了（WeAgent）。',
          ],
          redFlag: '训练奖励一路往上涨，但藏起来的测试集分数纹丝不动，九成已经出现作弊刷分或题面泄题。',
        },
        'data:pretrain': {
          lever: '别再照搬砍掉 95% 的狠过滤，多留些长尾唯一 token；多余的算力拿去做保真改写，或按实测配比借大语种拉小语种',
          signal: '盯紧每个语种有没有超过 1 轮（1 epoch）；在偏脏的核心池里试 DataRater，看训完能不能让验证集掉 loss',
          anchor: 'A Bitter Lesson for Data Filtering · ATLAS (1-epoch 拐点) · DataRater · Kimi K3 改写',
          whyTitle: '新数据快见底时，洗得太狠等于自己把路堵死',
          why: '模型够大、训得够久时，能自己把脏噪声隔开并榨出长尾信息；把池子硬砍剩 2% 到 13%，反复重训几轮很快过拟合。',
          traps: [
            '池子本来就不大，还照抄大厂 2% 留存率的强过滤器，结果数据量缩水太狠，没训多久就开始死背。',
            '印地语、斯瓦希里语这类小语种数据不够就机械多重复几轮，一超过 1 个 epoch 收益立刻掉头往下（ATLAS）。',
          ],
          redFlag: '训练 loss 还在降，但留出验证集 NLL 开始微微往上翘，说明滤太狠或重复太多，该放宽阈值或上保真改写了。',
        },
        'data:midtrain': {
          lever: '与其把同一批好数据干巴巴多喂几遍，不如换风格做保真改写，再补代码和图像/网页配对的程序化数据',
          signal: '改写完逐块核对原文防造假；脏池子可以用 DataRater 挑出真能让验证集掉 loss 的样本',
          anchor: 'Kimi K3 (§3.1 改写与程序化多模态) · DataRater (最高省 46.6% 净算力)',
          whyTitle: '好数据不够喂时，保真改写比干重复稳得多',
          why: '同一份知识换个讲法能继续提供新信息，前提是一定要对着原文查保真，不然会把改写模型的幻觉带进退火层。',
          traps: [
            '图省事直接挑训练 loss 最高的样本凑“高难语料”，结果把乱码和残缺网页全喂进了退火期。',
            '让大模型批量改写却不回查原文，事实错误会在退火期被迅速放大。',
          ],
          redFlag: '加上改写语料后，事实问答类评测反而掉分，先查有没有漏掉逐块原文核验。',
        },
        'data:sft': {
          lever: '从真实论文、仓库和网页事件搭知识图谱来出题，轨迹必须在跟线上完全一致的工具脚手架里跑通且答对',
          signal: '新概念进图谱前先合并同类项防雷同；轨迹只留完整跑通并拿到正确答案的那一批',
          anchor: 'Kimi K3 (§4.2 层级知识图谱 DAG) · WeAgent-MMSearch (同构 Harness 59.5K)',
          whyTitle: '真数据用完后，靠图谱扩题型，别靠改 prompt 模板',
          why: '光靠微调 prompt 模板造指令，造几千条就开始千篇一律；顺着真实知识图谱抓真材料出题，才能一直长出新题型。',
          traps: [
            '离线造数据时用一套简化模拟工具，线上部署换了另一套真实脚手架，格式对不上直接掉点。',
            '走灰产去扒闭源 API 密文思维链，漏洞很快会被堵死，还会踩合规和隐私泄露红线。',
          ],
          redFlag: '合成样本翻了一倍，但分布外评测一分不涨，说明造出来的题已经开始原地打转。',
        },
        'data:rl': {
          lever: '拿千万级真实交互记录把环境本身训成“世界模型”，再按需注入接口报错、分页截断这类生产边界做仿真 RL',
          signal: '给世界模型喂足细节初始状态（文件目录、表结构、账号配置），同时盯住真实在线环境的涨分情况',
          anchor: 'Qwen-AgentWorld (Sim RL · +12.3 MCPMark · +16.3 WideSearch) · WeAgent 逆向多跳',
          whyTitle: '真实沙箱太慢太贵，把“环境”训成模型才能放大量',
          why: '真实 API 很难按需触发偶发报错和截断，可控仿真却可以批量制造这些平时碰不到的边界故障。',
          traps: [
            '偷懒只给世界模型写几句笼统 prompt、不给细粒度初始状态，仿真聊几轮就彻底失真（Qwen-AgentWorld）。',
            '没数据库或 SQL 真值兜底，放任仿真器自己判对错，模型会把仿真幻觉当成正确动作学进去。',
          ],
          redFlag: '仿真环境里分数猛涨，一放到真实在线环境反而掉分，先查初始状态是不是给太粗、仿真已经脱离真实接口了。',
        },
      },
    }
  : {
      eyebrow: 'INTERACTIVE BOUNDARY LOCATOR · DATA TASTE DECISION MATRIX',
      title: 'Switch Resource Regime & Training Stage to See What Works vs. What Breaks',
      subtitle:
        'Pick your real bottleneck (compute-bound vs. fixed-pool data-bound) and stage. Each cell maps verified paper practices, low-cost gates, and the trap triggered when assumptions are mixed.',
      regimeLabel: 'Bottleneck Regime',
      stageLabel: 'Training Stage',
      leftHead: 'Grounded Engineering Playbook',
      rightHead: 'What Breaks When Premise Is Missed',
      labelLever: 'Primary Lever',
      labelSignal: 'Low-Cost Gate',
      labelAnchor: 'Paper Anchors',
      labelTrap: 'Typical Failure Modes',
      labelRedFlag: 'Pre-Flight Red Flag',
      regimes: [
        { id: 'compute', label: 'Compute-Bound (Large Pool · Tight GPUs)' },
        { id: 'data', label: 'Data-Bound (Fixed Pool · Multi-Epoch Limit)' },
      ],
      stages: [
        { id: 'pretrain', label: 'Pre-training' },
        { id: 'midtrain', label: 'Mid-training / Anneal' },
        { id: 'sft', label: 'SFT & Protocols' },
        { id: 'rl', label: 'RL & Agent Synth' },
      ],
      cells: {
        'compute:pretrain': {
          lever: 'Per-dump independent MinHash deduplication + lightweight semantic filtering for high information density',
          signal: 'Rank candidate corpora pairwise with 150M proxy models using continuous Correct Prob / Total Prob',
          anchor: 'Chinchilla · CCNet · FineWeb (15T) · DataMan (1.5B) · DataDecide',
          whyTitle: 'Why subtraction wins when FLOPs are scarce',
          why: 'Unique tokens vastly exceed your GPU budget, so spending finite FLOPs on cleaner, denser tokens lifts downstream quality without hitting a data wall.',
          traps: [
            'Global cross-dump deduplication across 96 dumps strips evergreen pages from older dumps and upsamples one-off ads and spam (FineWeb).',
            'Watching discrete Accuracy on MBPP or HumanEval at small proxy scale yields near-zero coin flips and discards strong coding corpora.',
          ],
          redFlag: 'If global dedup removes >80% of an early dump, run an ablation comparing the kept slice against the removed slice before shipping.',
        },
        'compute:midtrain': {
          lever: 'Concentrate high-precision math, code, and reasoning in annealing; mix long and short sequences during context extension',
          signal: 'Track short-context general benchmarks alongside synthetic long-doc retrieval with automated ground-truth checks',
          anchor: 'Nemotron 3 Nano Phase 2 (1.5T) + 121B Long-Context (512k/4k mix)',
          whyTitle: 'Annealing is the highest-leverage sharpening window',
          why: 'Shifting distribution in the final 5% to 10% of pre-training tokens sharpens reasoning and long-context recall without re-running 20T tokens.',
          traps: [
            'Training context extension exclusively on 512k sequences degrades standard short-context benchmarks (Nemotron 3).',
            'Treating annealing like SFT by flooding chat templates without high-quality knowledge replay makes base modeling brittle.',
          ],
          redFlag: 'If long-context scores jump while 4k general benchmarks dip >1 pt, increase short-sequence replay (e.g., Nemotron’s 79% Phase 2 downsample).',
        },
        'compute:sft': {
          lever: 'Encode runtime protocols directly in SFT (think toggle, budget truncation, tool use); switch to base hidden states on million-scale pools',
          signal: 'Always benchmark against random sampling at target pool scale; match validation queries via position-weighted RDS+',
          anchor: 'Nemotron 3 Nano (§3.1.5 10%/3% protocol) · DEITA (small pool) · RDS+ (5.8M pool)',
          whyTitle: 'SFT teaches behavioral protocols, not broad world knowledge',
          why: 'Graceful budget cutoffs and multi-turn tool switching only work reliably when written directly into SFT trajectories.',
          traps: [
            'At 5.8M scale, external judges, Perplexity, and IFD get gamed by outlier examples and can underperform random sampling (Ivison et al.).',
            'Training only on full CoT traces leaves models unable to converge when serving forcibly inserts </think> at a token cap.',
          ],
          redFlag: 'If a selection scorer fails to beat same-budget random sampling at full pool scale, drop the external judge immediately.',
        },
        'compute:rl': {
          lever: 'Stabilize format with cold-start SFT, then run isolated verifiers and rollout pass-rate filtering to keep high-contrast prompts',
          signal: 'Sample 8 rollouts per prompt; drop 8/8 all-pass and 0/8 all-fail tasks so RL spends compute only where group contrast exists',
          anchor: 'DeepSeek-R1 · Kimi K3 (AET isolated verifiers) · WeAgent-MMSearch (4.9K prompts)',
          whyTitle: 'RL compute is easily wasted on zero-gradient tasks and hacks',
          why: 'All-pass prompts offer no headroom and all-fail prompts provide no positive anchor; unisolated tests invite reward hacking.',
          traps: [
            'Pure RL without cold-start SFT triggers language mixing and unreadable traces (DeepSeek-R1-Zero).',
            'URLs or captions leak answers in multimodal search tasks, letting text shortcuts max out reward without reading pixels (WeAgent).',
          ],
          redFlag: 'Rising training reward paired with flat held-out verifier scores almost always signals reward hacking or shortcut leakage.',
        },
        'data:pretrain': {
          lever: 'Loosen harsh filtering thresholds to preserve unique tail tokens; allocate spare compute to faithful rephrasing and measured transfer mixes',
          signal: 'Track the 1-epoch boundary per language and test DataRater bi-level validation gain on high-noise core pools',
          anchor: 'A Bitter Lesson for Data Filtering · ATLAS (1-epoch inflection) · DataRater · Kimi K3',
          whyTitle: 'Once unique tokens run dry, harsh filters build your own data wall',
          why: 'Larger models trained longer can isolate noise and extract residual statistics; cutting a fixed pool to 2% to 13% trades away irreplaceable variety.',
          traps: [
            'Blindly copying 2% retention filters onto a fixed domain or language pool causes severe multi-epoch overfitting.',
            'Repeating low-resource languages (Hindi, Swahili) past 1 epoch triggers sharp diminishing returns (ATLAS).',
          ],
          redFlag: 'Training loss keeps dropping while held-out validation NLL curves upward: relax hard filters or shift to faithful rephrasing.',
        },
        'data:midtrain': {
          lever: 'Expand high-density data via multi-style faithful rephrasing and programmatic code-to-visual pairs instead of raw repetition',
          signal: 'Verify rephrased chunks against source documents; use DataRater meta-gradients on noisy pools to keep validation-lowering samples',
          anchor: 'Kimi K3 (§3.1 rephrasing & programmatic multimodal) · DataRater (up to 46.6% net FLOP gain)',
          whyTitle: 'Faithful rephrasing beats raw repetition in tight annealing pools',
          why: 'Diverse perspectives extend information yield, provided source-fidelity checks stop rewriter hallucinations from poisoning annealing.',
          traps: [
            'Picking raw highest-loss training examples as "hard data" selects gibberish and corrupted text.',
            'Bulk LLM rephrasing without chunk-level fidelity checks injects factual drift during the sensitive annealing phase.',
          ],
          redFlag: 'Factual recall benchmarks slip after adding rewritten corpora: audit chunk-level fidelity gating first.',
        },
        'data:sft': {
          lever: 'Synthesize diverse tasks from real seed states and self-evolving knowledge graphs; filter trajectories inside the exact deployment harness',
          signal: 'Deduplicate equivalent concepts before adding graph nodes; keep only complete, verified trajectories under isomorphic tool execution',
          anchor: 'Kimi K3 (§4.2 hierarchical knowledge graph DAG) · WeAgent-MMSearch (59.5K SFT)',
          whyTitle: 'Diversity at scale comes from structured graphs, not prompt tweaks',
          why: 'Template paraphrasing collapses quickly; anchoring graph walks to real papers, repos, and live web events preserves genuine task spread.',
          traps: [
            'Collecting trajectories in a mismatched mock harness causes tool-schema drift when deployed to the real runtime.',
            'Harvesting leaked proprietary API reasoning traces is legally toxic, leaks PII, and vanishes once vendors patch encryption scope.',
          ],
          redFlag: 'Doubling synthetic SFT volume moves OOD benchmarks by zero: your generator has entered mode collapse.',
        },
        'data:rl': {
          lever: 'Train language world models on 10M+ real interaction traces for Sim RL, systematically injecting edge-case faults and state shifts',
          signal: 'Condition world models on granular initial states (filesystems, schemas, configs) and validate Sim RL gains on real online evals',
          anchor: 'Qwen-AgentWorld (Sim RL · +12.3 MCPMark · +16.3 WideSearch) · WeAgent reverse hops',
          whyTitle: 'When live sandboxes bottleneck scale, model the environment itself',
          why: 'Live APIs rarely trigger pagination truncation, partial batch errors, or transient faults on demand; controllable world models can.',
          traps: [
            'Feeding vague seed prompts instead of fine-grained initial states causes simulated trajectories to drift within a few turns (Qwen-AgentWorld).',
            'Letting an unconstrained simulator self-grade without database/SQL ground truth bakes simulator hallucinations into policy weights.',
          ],
          redFlag: 'Sim RL scores climb fast while real online evaluation drops: tighten initial-state conditioning and ground-truth checks.',
        },
      },
    };

const payload = JSON.stringify({
  cells: copy.cells,
  labels: {
    lever: copy.labelLever,
    signal: copy.labelSignal,
    anchor: copy.labelAnchor,
    trap: copy.labelTrap,
    redFlag: copy.labelRedFlag,
  },
});
---

<section class="dtl-box not-prose" data-widget="data-taste-boundary-lab" data-payload={payload}>
  <header class="dtl-head">
    <p class="dtl-eyebrow">{copy.eyebrow}</p>
    <h4 class="dtl-title">{copy.title}</h4>
    <p class="dtl-subtitle">{copy.subtitle}</p>
  </header>

  <div class="dtl-controls">
    <div class="dtl-control-group">
      <span class="dtl-control-label">{copy.regimeLabel}</span>
      <div class="dtl-pills" role="tablist">
        {copy.regimes.map((r, idx) => (
          <button
            type="button"
            class:list={['dtl-pill', idx === 0 && 'is-active']}
            data-regime={r.id}
            aria-pressed={idx === 0 ? 'true' : 'false'}
          >
            {r.label}
          </button>
        ))}
      </div>
    </div>

    <div class="dtl-control-group">
      <span class="dtl-control-label">{copy.stageLabel}</span>
      <div class="dtl-tabs" role="tablist">
        {copy.stages.map((s, idx) => (
          <button
            type="button"
            class:list={['dtl-tab', idx === 0 && 'is-active']}
            data-stage={s.id}
            aria-pressed={idx === 0 ? 'true' : 'false'}
          >
            {s.label}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="dtl-grid">
    <div class="dtl-col dtl-col-teal">
      <p class="dtl-col-head">{copy.leftHead}</p>
      <div class="dtl-body" data-left-panel></div>
    </div>

    <div class="dtl-col dtl-col-terra">
      <p class="dtl-col-head">{copy.rightHead}</p>
      <div class="dtl-body" data-right-panel></div>
    </div>
  </div>
</section>

<script>
  function initDataTasteBoundaryLabs() {
    document.querySelectorAll<HTMLElement>('[data-widget="data-taste-boundary-lab"]').forEach((root) => {
      if (root.dataset.bound === '1') return;
      root.dataset.bound = '1';

      const { cells, labels } = JSON.parse(root.dataset.payload || '{"cells":{},"labels":{}}');
      let regime = 'compute';
      let stage = 'pretrain';

      const regimeBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-regime]'));
      const stageBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-stage]'));
      const leftPanel = root.querySelector<HTMLElement>('[data-left-panel]');
      const rightPanel = root.querySelector<HTMLElement>('[data-right-panel]');

      function escapeHtml(text: string) {
        return text
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;');
      }

      function render() {
        regimeBtns.forEach((btn) => {
          const active = btn.dataset.regime === regime;
          btn.classList.toggle('is-active', active);
          btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        stageBtns.forEach((btn) => {
          const active = btn.dataset.stage === stage;
          btn.classList.toggle('is-active', active);
          btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        const cell = cells[`${regime}:${stage}`];
        if (!cell) return;

        if (leftPanel) {
          leftPanel.innerHTML = `
            <div class="dtl-item">
              <div class="dtl-k">${escapeHtml(labels.lever)}</div>
              <p class="dtl-v">${escapeHtml(cell.lever)}</p>
            </div>
            <div class="dtl-item">
              <div class="dtl-k">${escapeHtml(labels.signal)}</div>
              <p class="dtl-v">${escapeHtml(cell.signal)}</p>
            </div>
            <div class="dtl-item">
              <div class="dtl-k">${escapeHtml(labels.anchor)}</div>
              <p class="dtl-anchor">${escapeHtml(cell.anchor)}</p>
            </div>
            <div class="dtl-callout dtl-callout-teal">
              <div class="dtl-callout-t dtl-t-teal">${escapeHtml(cell.whyTitle)}</div>
              <p class="dtl-callout-p">${escapeHtml(cell.why)}</p>
            </div>
          `;
        }

        if (rightPanel) {
          const trapsHtml = cell.traps
            .map((t: string) => `<li>${escapeHtml(t)}</li>`)
            .join('');
          rightPanel.innerHTML = `
            <div class="dtl-item">
              <div class="dtl-k dtl-k-terra">${escapeHtml(labels.trap)}</div>
              <ul class="dtl-list">${trapsHtml}</ul>
            </div>
            <div class="dtl-callout dtl-callout-terra">
              <div class="dtl-callout-t dtl-t-terra">${escapeHtml(labels.redFlag)}</div>
              <p class="dtl-callout-p">${escapeHtml(cell.redFlag)}</p>
            </div>
          `;
        }
      }

      regimeBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          regime = btn.dataset.regime || 'compute';
          render();
        });
      });

      stageBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          stage = btn.dataset.stage || 'pretrain';
          render();
        });
      });

      render();
    });
  }

  initDataTasteBoundaryLabs();
  document.addEventListener('astro:after-swap', initDataTasteBoundaryLabs);
  document.addEventListener('languagechange', initDataTasteBoundaryLabs);
</script>


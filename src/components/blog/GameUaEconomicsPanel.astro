          summary: 'Ad revenue floors early cashflow while in-app purchases lift the long-term ceiling; requires unified IAA+IAP value backfeed.',
          cpi: '$2.00 - $5.50',
          payback: 'D21 - D45',
          d7: '44%',
          d90: '132%',
          goal: 'Hybrid tROAS / VBO',
          risk: 'Mixing immediate ad impressions with delayed IAP conversions',

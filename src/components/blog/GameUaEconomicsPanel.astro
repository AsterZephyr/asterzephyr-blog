            { day: 'D1', roas: 18 },
            { day: 'D3', roas: 31 },
            { day: 'D7', roas: 44 },
            { day: 'D14', roas: 65 },
            { day: 'D30', roas: 96 },
            { day: 'D90', roas: 132 },
          ],
        },
        {
          id: 'iap',
          tab: '重度 SLG / RPG (IAP)',
          summary: '95% 以上用户零付费，极少数鲸鱼玩家贡献大部分流水；前期深度垫资，完全依赖高精度 pLTV 预估。',
          cpi: '$12.00 - $35.00',
          payback: 'D90 - D180',
          d7: '19%',

      title: 'Cashflow & Cumulative ROAS Curves Across Game Genres',
      subtitle: 'Switch monetization regimes to inspect CPI bands, D1-D90 ROAS ramp speed, payback horizons, and bidding objectives.',
      breakeven: '100% Breakeven',
      metrics: {
        cpi: 'Typical CPI Band',
        payback: 'Target Payback',
        d7: 'D7 Cum. ROAS',
        d90: 'D90 Cum. ROAS',
        goal: 'Primary Bid Goal',
        risk: 'Dominant Modeling Bottleneck',
      },
      genres: [
        {
          id: 'iaa',
          tab: 'Hyper-Casual (IAA)',

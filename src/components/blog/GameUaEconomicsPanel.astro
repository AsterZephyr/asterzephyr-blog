          payback: 'D90 - D180',
          d7: '19%',
          d90: '98%',
          goal: 'VBO / D7 tROAS (pLTV)',
          risk: 'Zero-inflated heavy tails, long conversion delays, and SKAN loss',
          points: [
            { day: 'D1', roas: 6 },
            { day: 'D3', roas: 12 },
            { day: 'D7', roas: 19 },

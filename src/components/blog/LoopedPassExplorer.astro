      ],
      stages: [
        {
          id: 'prelude',
          tab: '1. Prelude',
          activeBlocks: ['b1'],
          gateActive: false,
          bypassActive: false,
          visits: '6 / 48',
          activeParams: '~1.2B',
          globalKv: '1 / 8 层',
          d2027: '未激活',
          d2027Tone: 'muted',
          headline: 'Block 1 (L0-L5) 只跑 1 次：建立入口表示与基线',
          detail: '入口词法编码与局部上下文提取在此完成。输出不仅送入 Core Pass 1，还会作为固定基线保留给后续 Pass 2 和 Pass 3，避免反复覆盖冲淡原始词元信息。',
        },
        {

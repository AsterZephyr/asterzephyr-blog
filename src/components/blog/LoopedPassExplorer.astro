---
interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;
const isZh = lang === 'zh';

const copy = isZh
  ? {
      eyebrow: '交互式架构步进 · INKLING 2 MINI (24 层权重 -> 48 次层访问)',
      title: '逐步跟踪共享 Core 的三轮循环、跨轮门控与状态开销',
      subtitle: '点击或切换下方 5 个执行阶段，观察 24 层物理权重如何复用、rank-64 门控何时介入、Goodfire 发现的 d_2027 路由标签如何拉高与清零。',
      prev: '上一阶段',
      next: '下一阶段',
      labels: {
        visits: '累计层访问',

          tab: '2. Core Pass 1',
          activeBlocks: ['b2', 'b3'],
          gateActive: false,
          bypassActive: false,
          visits: '18 / 48',
          activeParams: '~2.4B',
          globalKv: '3 / 8 层',
          d2027: '末层大幅拉高 (写标签)',
          d2027Tone: 'warn',
          headline: 'Core 第 1 轮 (L6-L17)：首轮语义整合与跨轮打标',
          detail: '中间 12 层首次执行，写入第 1 组 L11/L17 全局 KV。Goodfire 白盒观测显示，在 Pass 1 末层附近，d_2027 等异常坐标被大幅拉高，为下一轮 Block 3 读取器写入路由标记。',
        },
        {
          id: 'pass2',
          tab: '3. Core Pass 2',

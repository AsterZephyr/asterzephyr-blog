---
interface Props {
  title?: string;
  caption?: string;
}

const { title, caption } = Astro.props;
---

<figure class="not-prose my-8">
  {title && (
    <div class="text-center mb-3">
      <span class="text-sm font-semibold uppercase tracking-wider text-[var(--color-muted)]">{title}</span>
    </div>
  )}
  <div class="diagram-wrapper rounded-lg border border-[var(--color-border)] bg-[#1a1b26] p-4 overflow-x-auto">
    <slot />
  </div>
  {caption && (
    <figcaption class="mt-3 text-center text-sm text-[var(--color-muted)] italic">
      {caption}
    </figcaption>
  )}
</figure>

<style>
  .diagram-wrapper :global(.mermaid-diagram) {
    margin: 0;
  }
  .diagram-wrapper :global(pre[data-language="mermaid"]) {
    margin: 0;
    background: transparent;
    border: none;
    padding: 0;
  }
</style>

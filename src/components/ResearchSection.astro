---
import { getCollection } from 'astro:content';
import ResearchCard from './ResearchCard.astro';

const allResearch = await getCollection('research');
const featured = allResearch
  .filter((r) => r.data.featured)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const items = featured.length > 0 ? featured : allResearch.slice(0, 4);
---
{items.length > 0 && (
  <section id="research" class="py-24 bg-[var(--color-surface-alt)] section-animate">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-14">
        <h2 class="font-heading text-3xl font-bold uppercase tracking-wide">Research</h2>
        <div class="w-12 h-0.5 bg-[var(--color-accent-light)] mx-auto mt-4"></div>
      </div>
      <div class="space-y-8">
        {items.map((item) => (
          <ResearchCard item={item} />
        ))}
      </div>
    </div>
  </section>
)}

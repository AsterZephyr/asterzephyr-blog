---
import LocalizedText from './LocalizedText.astro';
---
<dialog class="image-viewer" aria-label="Image viewer">
  <div class="image-viewer-toolbar">
    <button type="button" data-zoom="out" aria-label="Zoom out">−</button>
    <button type="button" data-zoom="reset" aria-label="Reset zoom">100%</button>
    <button type="button" data-zoom="in" aria-label="Zoom in">+</button>
    <button type="button" data-viewer-close autofocus><LocalizedText zh="关闭" en="Close" /><span aria-hidden="true"> ×</span></button>
  </div>
  <div class="image-viewer-stage" tabindex="0" role="region" aria-label="Image area; use arrow keys to pan when zoomed"><img alt="" draggable="false" /></div>
  <p class="image-viewer-caption" aria-live="polite"></p>
</dialog>
<script>
  import '../scripts/reader-navigation';
  import '../scripts/reader-media';
</script>

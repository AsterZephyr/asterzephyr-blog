---
import LocalizedText from './LocalizedText.astro';
import { TAG_LABELS } from '../data/blog-tags';
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---
{tags.length > 0 && (
  <div class="flex flex-wrap gap-x-5 gap-y-1">
    {tags.map((tag) => (
      <a
        href={`/tags/${tag}/`}
        class="topic-link"
      >
        <LocalizedText zh={tag} en={TAG_LABELS[tag] || tag} />
      </a>
    ))}
  </div>
)}

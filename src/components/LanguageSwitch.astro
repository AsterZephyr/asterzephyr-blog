<div class="language-switch" role="group" aria-label="Language / 语言" hidden>
  <button type="button" data-set-language="zh" lang="zh-CN" aria-label="切换为中文" aria-pressed="true">中文</button>
  <span aria-hidden="true">/</span>
  <button type="button" data-set-language="en" lang="en" aria-label="Switch to English" aria-pressed="false">EN</button>
</div>
<style>
  .language-switch:not([hidden]) { display: flex; align-items: center; gap: 2px; flex-shrink: 0; }
  button { min-width: 40px; min-height: 44px; font-size: 12px; color: inherit; opacity: .65; }
  button[aria-pressed='true'] { opacity: 1; text-decoration: underline; text-underline-offset: 6px; }
  button:hover { opacity: 1; }
  span { opacity: .4; font-size: 11px; }
</style>

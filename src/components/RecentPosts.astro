---
import { getCollection } from 'astro:content';
import BlogCard from './BlogCard.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---
{recentPosts.length > 0 && (
  <section id="recent-posts" class="py-24 bg-[var(--color-surface-alt)] section-animate">
    <div class="mx-auto max-w-6xl px-6">
      <div class="text-center mb-14">
        <h2 class="font-heading text-3xl font-bold uppercase tracking-wide">Latest Posts</h2>
        <div class="w-12 h-0.5 bg-[var(--color-accent-light)] mx-auto mt-4"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {recentPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
      <div class="text-center mt-12">
        <a
          href="/blog"
          class="inline-block bg-[var(--color-accent)] text-white px-6 py-2.5 text-sm font-medium uppercase tracking-wider hover:bg-[var(--color-accent-light)] border-2 border-[var(--color-accent)] hover:border-[var(--color-accent-light)] transition-all"
        >
          View All Posts
        </a>
      </div>
    </div>
  </section>
)}
